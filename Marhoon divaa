--==================================================
-- SPEED
--==================================================

local speed = 1

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(1,-20,0,35)
speedLabel.Position = UDim2.fromOffset(10,110)
speedLabel.Text = "⚡ Speed: 1"
