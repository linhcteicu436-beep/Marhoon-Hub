speedLabel.BackgroundTransparency = 1
speedLabel.Parent = menu

local plus = Instance.new("TextButton")
plus.Size = UDim2.fromOffset(145,40)
plus.Position = UDim2.fromOffset(10,150)
plus.Text = "+ Speed"
plus.TextScaled = true
plus.Parent = menu

local minus = Instance.new("TextButton")
minus.Size = UDim2.fromOffset(145,40)
minus.Position = UDim2.fromOffset(175,150)
minus.Text = "- Speed"
minus.TextScaled = true
minus.Parent = menu

local function setSpeed()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.WalkSpeed = speed
	end

	speedLabel.Text = "⚡ Speed: "..speed
end

plus.MouseButton1Click:Connect(function()
	speed = math.clamp(speed + 1,1,200)
	setSpeed()
end)

minus.MouseButton1Click:Connect(function()
	speed = math.clamp(speed - 1,1,200)
	setSpeed()
end)

--==================================================
-- BUTTON CREATOR
--==================================================

local function button(text,y,callback)

	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-20,0,45)
	b.Position = UDim2.fromOffset(10,y)
	b.Text = text
	b.TextScaled = true
	b.Parent = menu

	b.MouseButton1Click:Connect(callback)

	return b
end

--==================================================
-- DAMAGE / GRAB / FREEZE
--==================================================

button("🥊 Đánh người chơi",205,function()

	local name = target.Text:lower()

	for _,plr in ipairs(Players:GetPlayers()) do

		if plr.Name:lower() == name then

			local character = plr.Character
			local humanoid =
				character and character:FindFirstChildOfClass("Humanoid")

			if humanoid then
				print("Đã chọn "..plr.Name)

				-- Combat nên xử lý bằng ServerScript
				-- trong game của bạn.
			end
		end
	end
end)

button("⚡ Đánh nhanh",255,function()

	print("Fast Attack được chọn.")

	-- Phần combat thật nên xử lý
	-- bằng server của game bạn.
end)

button("🧲 Túm / Kéo",305,function()

	local name = target.Text:lower()

	for _,plr in ipairs(Players:GetPlayers()) do

		if plr.Name:lower() == name then

			local targetChar = plr.Character
			local myChar = player.Character

			local targetRoot =
				targetChar and targetChar:FindFirstChild("HumanoidRootPart")

			local myRoot =
				myChar and myChar:FindFirstChild("HumanoidRootPart")

			if targetRoot and myRoot then
				print("Đã chọn "..plr.Name.." để Grab.")
				-- Cần ServerScript để di chuyển
				-- nhân vật người chơi khác.
			end
		end
	end
end)

button("❄️ Khóa người chơi",355,function()

