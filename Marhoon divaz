server.Source = [[
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local ADMIN_USER_ID = ]] .. tostring(ADMIN_USER_ID) .. [[

local Remote = ReplicatedStorage:WaitForChild("MarhoonAdminRemote")

local frozen = {}

local function isAdmin(player)
	return player and player.UserId == ADMIN_USER_ID
end

local function findPlayer(text)
	if typeof(text) ~= "string" then
		return nil
	end

	text = text:lower():gsub("^%s+", ""):gsub("%s+$", "")

	if text == "" then
		return nil
	end

	-- Username chính xác
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower() == text then
			return player
		end
	end

	-- DisplayName
	for _, player in ipairs(Players:GetPlayers()) do
		if player.DisplayName:lower() == text then
			return player
		end
	end

	-- Username bắt đầu bằng chuỗi nhập
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower():sub(1, #text) == text then
			return player
		end
	end

	return nil
end

local function humanoid(player)
	if not player.Character then
		return nil
	end

	return player.Character:FindFirstChildOfClass("Humanoid")
end

local function root(player)
	if not player.Character then
		return nil
	end

	return player.Character:FindFirstChild("HumanoidRootPart")
end

Remote.OnServerEvent:Connect(function(admin, action, targetName, value)

	-- SERVER-SIDE ADMIN CHECK
	if not isAdmin(admin) then
		return
	end

	-- SPEED 1 -> 200
	if action == "Speed" then
		local amount = math.clamp(tonumber(value) or 16, 1, 200)
		local h = humanoid(admin)

		if h then
			h.WalkSpeed = amount
		end

		return
	end

	-- DAMAGE
	if action == "Damage" then
		local target = findPlayer(targetName)

		if not target or target == admin then
			return
		end

		local h = humanoid(target)

		if h then
			local damage = math.clamp(
				tonumber(value) or 10,
				1,
				100
			)

			h:TakeDamage(damage)
		end

		return
	end

	-- FREEZE
	if action == "Freeze" then
		local target = findPlayer(targetName)

		if not target or target == admin then
			return
		end

		local h = humanoid(target)

		if h then
			frozen[target] = true

			h.WalkSpeed = 0
			h.JumpPower = 0
			h.AutoRotate = false
		end

		return
	end

	-- UNFREEZE
	if action == "Unfreeze" then
		local target = findPlayer(targetName)

		if not target then
			return
		end

		local h = humanoid(target)

		if h then
			frozen[target] = nil

			h.WalkSpeed = 16
			h.JumpPower = 50
			h.AutoRotate = true
		end

		return
	end

	-- GRAB
	if action == "Grab" then
		local target = findPlayer(targetName)

		if not target or target == admin then
			return
		end

		local adminRoot = root(admin)
		local targetRoot = root(target)

		if adminRoot and targetRoot then
			targetRoot.CFrame =
				adminRoot.CFrame * CFrame.new(0, 0, -5)
		end

		return
	end

	-- SERVER HOP
	if action == "ServerHop" then
		local success, code = pcall(function()
			return TeleportService:ReserveServer(game.PlaceId)
		end)

		if success and code then
			pcall(function()
				TeleportService:TeleportToPrivateServer(
					game.PlaceId,
					code,
					{admin}
				)
			end)
		end

		return
	end
end)

Players.PlayerAdded:Connect(function(player)

	player.CharacterAdded:Connect(function(character)

		if frozen[player] then
			local h = character:WaitForChild("Humanoid")

			h.WalkSpeed = 0
			h.JumpPower = 0
			h.AutoRotate = false
		end

	end)

end)

Players.PlayerRemoving:Connect(function(player)
	frozen[player] = nil
end)
]]

