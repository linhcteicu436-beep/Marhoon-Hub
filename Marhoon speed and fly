--==================================================
-- SPEED CONTROL
--==================================================

local function updateSpeed()
	speedLabel.Text = "SPEED: "..SPEED

	if speedEnabled and humanoid then
		humanoid.WalkSpeed = SPEED
		speedToggle.Text = "SPEED: ON ("..SPEED..")"
	end
end

speedMinus.MouseButton1Click:Connect(function()
	SPEED = math.max(1,SPEED - 1)
	updateSpeed()
end)

speedPlus.MouseButton1Click:Connect(function()
	SPEED = math.min(200,SPEED + 1)
	updateSpeed()
end)

speedToggle.MouseButton1Click:Connect(function()
	speedEnabled = not speedEnabled

	if speedEnabled then
		humanoid.WalkSpeed = SPEED

		speedToggle.Text = "SPEED: ON ("..SPEED..")"
		speedToggle.BackgroundColor3 = Color3.fromRGB(40,150,70)
	else
		humanoid.WalkSpeed = 16

		speedToggle.Text = "SPEED: OFF"
		speedToggle.BackgroundColor3 = Color3.fromRGB(60,60,60)
	end
end)

--==================================================
-- FLY SPEED
--==================================================

local function updateFlyText()
	flyLabel.Text = "FLY: "..FLY_SPEED

	if flyEnabled then
		flyToggle.Text = "FLY: ON ("..FLY_SPEED..")"
	end
end

flyMinus.MouseButton1Click:Connect(function()
	FLY_SPEED = math.max(1,FLY_SPEED - 1)
	updateFlyText()
end)

flyPlus.MouseButton1Click:Connect(function()
	FLY_SPEED = math.min(200,FLY_SPEED + 1)
	updateFlyText()
end)

--==================================================
-- STOP FLY
--==================================================

local function stopFly()

	flyEnabled = false

	if linearVelocity then
		linearVelocity:Destroy()
		linearVelocity = nil
	end

	if alignOrientation then
		alignOrientation:Destroy()
		alignOrientation = nil
	end

	if attachment then
		attachment:Destroy()
		attachment = nil
	end

	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end

	flyToggle.Text = "FLY: OFF"
	flyToggle.BackgroundColor3 = Color3.fromRGB(60,60,60)
end

--==================================================
-- START FLY
--==================================================

local function startFly()

	if not character or not humanoid or not rootPart then
		return
	end

	-- Xóa hệ thống cũ nếu còn
	stopFly()

	flyEnabled = true

	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	-- Attachment
	attachment = Instance.new("Attachment")
	attachment.Name = "MarhoonFlyAttachment"
	attachment.Parent = rootPart

	-- LinearVelocity
	linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Name = "MarhoonFlyVelocity"
	linearVelocity.Attachment0 = attachment
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.MaxForce = math.huge
	linearVelocity.VectorVelocity = Vector3.zero
	linearVelocity.Parent = rootPart

	-- AlignOrientation
	alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "MarhoonFlyOrientation"
	alignOrientation.Attachment0 = attachment
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.MaxTorque = math.huge
	alignOrientation.Responsiveness = 50
	alignOrientation.Parent = rootPart

	flyToggle.Text = "FLY: ON ("..FLY_SPEED..")"
	flyToggle.BackgroundColor3 = Color3.fromRGB(40,150,70)
end

--==================================================
-- FLY MOVEMENT
--==================================================

RunService.RenderStepped:Connect(function()

	if not flyEnabled then
		return
	end

	if not rootPart or not rootPart.Parent then
		return
	end

	if not linearVelocity or not alignOrientation then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local direction = Vector3.zero

	-- W
	if UIS:IsKeyDown(Enum.KeyCode.W) then
		direction += camera.CFrame.LookVector
	end

	-- S
	if UIS:IsKeyDown(Enum.KeyCode.S) then
		direction -= camera.CFrame.LookVector
	end

	-- A
	if UIS:IsKeyDown(Enum.KeyCode.A) then
		direction -= camera.CFrame.RightVector
	end

	-- D
	if UIS:IsKeyDown(Enum.KeyCode.D) then
		direction += camera.CFrame.RightVector
	end

	-- Space = lên
	if UIS:IsKeyDown(Enum.KeyCode.Space) then
		direction += Vector3.new(0,1,0)
	end

	-- Ctrl = xuống
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction -= Vector3.new(0,1,0)
	end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	-- Áp dụng tốc độ bay
	linearVelocity.VectorVelocity = direction * FLY_SPEED

	-- Xoay nhân vật theo camera
	local look = camera.CFrame.LookVector

	alignOrientation.CFrame = CFrame.lookAt(
		Vector3.zero,
		Vector3.new(look.X,0,look.Z)
	)
end)

