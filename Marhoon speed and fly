-- Phím M
UIS.InputBegan:Connect(function(input,processed)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.M then
		frame.Visible = not frame.Visible
		openButton.Visible = not frame.Visible
	end

end)
