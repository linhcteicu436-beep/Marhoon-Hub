local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ĐỔI THÀNH USER ID CỦA BẠN
local ADMIN_USER_ID = 123456789

local remote = ReplicatedStorage:FindFirstChild("AdminRemote")

if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "AdminRemote"
	remote.Parent = ReplicatedStorage
end

local frozen = {}

local function admin(player)
	return player.UserId == ADMIN_USER_ID
end

local function findPlayer(name)
	if typeof(name) ~= "string" then
		return nil
	end

	name = name:lower():gsub("^%s+", ""):gsub("%s+$", "")

	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == name then
			return p
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p.DisplayName:lower() == name then
			return p
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #name) == name then
			return p
		end
	end

	return nil
end

local function getHumanoid(player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

remote.OnServerEvent:Connect(function(player, action, targetName, value)

	-- QUAN TRỌNG: kiểm tra ở SERVER
	if not admin(player) then
		return
	end

	-- SPEED
	if action == "Speed" then
		local humanoid = getHumanoid(player)

		if humanoid then
			humanoid.WalkSpeed = math.clamp(
				tonumber(value) or 16,
				1,
				200
			)
		end

		return
	end

	local target = findPlayer(targetName)

	-- DAMAGE
	if action == "Damage" and target then
		local humanoid = getHumanoid(target)

		if humanoid and target ~= player then
			humanoid:TakeDamage(
				math.clamp(tonumber(value) or 10, 1, 100)
			)
		end

		return
	end

	-- FREEZE
	if action == "Freeze" and target then
		local humanoid = getHumanoid(target)

		if humanoid and target ~= player then
			frozen[target] = true

			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.AutoRotate = false
		end

		return
	end

	-- UNFREEZE
	if action == "Unfreeze" and target then
		local humanoid = getHumanoid(target)

		if humanoid then
			frozen[target] = nil

			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
			humanoid.AutoRotate = true
		end

		return
	end

	-- GRAB
	if action == "Grab" and target then
		if target == player then
			return
		end

		local adminRoot = getRoot(player)
		local targetRoot = getRoot(target)

		if adminRoot and targetRoot then
			targetRoot.CFrame =
				adminRoot.CFrame * CFrame.new(0, 0, -6)
		end

		return
	end
end)

Players.PlayerRemoving:Connect(function(player)
	frozen[player] = nil
end)
